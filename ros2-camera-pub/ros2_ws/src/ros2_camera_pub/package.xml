<?xml version="1.0"?>
<package format="3">
  <name>ros2_camera_pub</name>
  <version>1.0.0</version>
  <description>Muscat plugin backend: an Intel RealSense (librealsense, no realsense-ros) as ROS topics, the streams and settings chosen in the plugin UI</description>
  <maintainer email="sangmin.jeon@rainbow-robotics.com">sangmin.jeon</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcl</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
